<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeInfoFragment">

    <fragment
        android:id="@+id/homeInfoFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.HomeInfoFragment"
        android:label="HomeInfoFragment" >
        <action
            android:id="@+id/action_homeInfoFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_coachDashboardFragment"
            app:destination="@id/coachDashboardFragment" />
        <action
            android:id="@+id/action_loginFragment_to_athleteDashboardFragment"
            app:destination="@id/athleteDashboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/coachDashboardFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.CoachDashboardFragment"
        android:label="Dashboard Allenatrice"
        tools:layout="@layout/fragment_coach_dashboard">
        <action
            android:id="@+id/action_coachDashboard_to_gestioneAtlete"
            app:destination="@id/gestioneAtleteFragment" />
        <action
            android:id="@+id/action_coachDashboardFragment_to_presenzeFragment"
            app:destination="@id/presenzeFragment" />
        <action
            android:id="@+id/action_coachDashboardFragment_to_listaGareFragment"
            app:destination="@id/listaGareFragment" />
        <action
            android:id="@+id/action_coachDashboardFragment_to_iscrizioniGaraFragment"
            app:destination="@id/iscrizioniGaraFragment" />
        <action
            android:id="@+id/action_coachDashboardFragment_to_profiloAllenatriceFragment2"
            app:destination="@id/profiloAllenatriceFragment" />
        <action
            android:id="@+id/action_coachDashboardFragment_to_analisiPosaFragment"
            app:destination="@id/analisiPosaFragment" />
    </fragment>

    <fragment
        android:id="@+id/gestioneAtleteFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.GestioneAtleteFragment"
        android:label="GestioneAtleteFragment" >
        <action
            android:id="@+id/action_gestioneAtleteFragment_to_dettaglioAtletaFragment"
            app:destination="@id/dettaglioAtletaFragment" />
    </fragment>

    <fragment
        android:id="@+id/dettaglioAtletaFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.DettaglioAtletaFragment"
        android:label="DettaglioAtletaFragment" >
        <argument
            android:name="atletaId"
            app:argType="string" />
        <argument
            android:name="atletaNome"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/presenzeFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.PresenzeFragment"
        android:label="Registro Appello"
        tools:layout="@layout/fragment_presenze" />

    <fragment
        android:id="@+id/athleteDashboardFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.AthleteDashboardFragment"
        android:label="Area Atleta"
        tools:layout="@layout/fragment_athlete_dashboard">
    </fragment>

    <fragment
        android:id="@+id/listaGareFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.ListaGareFragment"
        android:label="Gare Programmate"
        tools:layout="@layout/fragment_lista_gare" >
        <action
            android:id="@+id/action_listaGareFragment_to_iscrizioniGaraFragment"
            app:destination="@id/iscrizioniGaraFragment" />
    </fragment>

    <fragment
        android:id="@+id/iscrizioniGaraFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.IscrizioniGaraFragment"
        android:label="Gestione Iscrizioni"
        tools:layout="@layout/fragment_iscrizioni_gare" >
        <argument
            android:name="garaId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profiloAllenatriceFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.ProfiloAllenatriceFragment"
        android:label="ProfiloAllenatriceFragment" />

    <fragment
        android:id="@+id/analisiPosaFragment"
        android:name="com.example.ginnasticaritmica.ui.fragment.AnalisiPosaFragment"
        android:label="Analisi Posa"
        tools:layout="@layout/fragment_analisi_posa" />

</navigation>