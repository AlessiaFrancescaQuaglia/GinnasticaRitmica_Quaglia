<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuova Ginnasta"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#6200EA"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNome"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nome"
        android:inputType="textPersonName"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etCognome"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Cognome"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <!-- Bottone per scegliere la data (il DatePicker si aprirà al click) -->
    <Button
        android:id="@+id/btnDataNascita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleziona Data di Nascita *"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Livello"
        android:textSize="14sp"
        android:layout_marginStart="4dp"/>

    <Spinner
        android:id="@+id/spinnerLivello"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"/>

    <!-- Bottone per certificato (opzionale) -->
    <Button
        android:id="@+id/btnDataCertificato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Certificato (Opzionale)"
        style="?attr/materialButtonOutlinedStyle"/>

</LinearLayout>