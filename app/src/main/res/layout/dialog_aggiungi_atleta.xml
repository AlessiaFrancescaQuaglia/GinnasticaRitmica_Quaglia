<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/sfondo_app"
    android:padding="24dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuova Ginnasta"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/viola_torre"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNome"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:autofillHints=""
        android:hint="Nome"
        android:textColor="@color/testo_titoli"
        android:textColorHint="@color/testo_chiaro"
        android:inputType="textPersonName"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etCognome"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:autofillHints=""
        android:hint="Cognome"
        android:textColor="@color/testo_titoli"
        android:textColorHint="@color/testo_chiaro"
        android:inputType="textPersonName"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEmailAtleta"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:autofillHints=""
        android:hint="Email della Ginnasta (per il suo accesso)"
        android:inputType="textEmailAddress"
        android:textColor="@color/testo_titoli"
        android:textColorHint="#757575" />

    <Button
        android:id="@+id/btnDataNascita"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleziona Data di Nascita *"
        android:backgroundTint="@color/viola_torre"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Livello"
        android:textColor="@color/testo_sottotitoli"
        android:textSize="14sp"
        android:layout_marginStart="4dp"/>

    <Spinner
        android:id="@+id/spinnerLivello"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnDataCertificato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Data Certificato (Opzionale)"
        android:textColor="@color/viola_torre"
        app:strokeColor="@color/viola_torre"
        style="?attr/materialButtonOutlinedStyle"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSalvaPersonalizzato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SALVA"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/viola_torre"
        app:strokeColor="@color/viola_torre"
        style="?attr/materialButtonOutlinedStyle"
        app:cornerRadius="8dp" />

</LinearLayout>