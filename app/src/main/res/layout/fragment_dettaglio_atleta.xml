<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/sfondo_app">

        <!-- BANNER VIOLA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/viola_torre"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnTornaIndietro"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Dettaglio Atleta"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="32dp"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/imgProfiloAtleta"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/grigio_box" />

                <Button
                    android:id="@+id/btnModificaFoto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cambia Foto" />

                <TextView
                    android:id="@+id/tvNomeDettaglio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome Atleta"
                    android:textColor="@color/testo_titoli"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvCategoriaDettaglio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Livello • Categoria"
                    android:textSize="16sp"
                    android:textColor="@color/testo_chiaro"
                    android:layout_marginBottom="24dp"/>

                <!-- BOX 1: Profilo Tecnico (Stile Dashboard) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/grigio_box"
                    android:padding="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profilo Tecnico"
                        android:textColor="@color/testo_titoli"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvLivelloScelto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Livello: Non inserito"
                        android:textColor="@color/testo_sottotitoli"/>
                    <Button
                        android:id="@+id/btnModificaLivello"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modifica Livello"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvDataNascita"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data di nascita: Non inserita"
                        android:textColor="@color/testo_sottotitoli"/>
                    <Button
                        android:id="@+id/btnModificaNascita"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modifica Nascita (Calcola Categoria)"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvEmailAtletaDettaglio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email di accesso: Non inserita"
                        android:textColor="@color/testo_sottotitoli"/>

                    <Button
                        android:id="@+id/btnModificaEmail"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Collega / Modifica Email Atleta"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvAttrezziUsati"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Attrezzi dell'anno: Nessuno"
                        android:textColor="@color/testo_sottotitoli"/>
                    <Button
                        android:id="@+id/btnModificaAttrezzi"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scegli Attrezzi"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvGruppoScelto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gruppo: Non assegnato"
                        android:textStyle="bold"
                        android:textColor="@color/verde_acqua_bottoni"
                        android:layout_marginTop="8dp"/>
                    <Button
                        android:id="@+id/btnModificaGruppo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Assegna Gruppo di Lavoro" />

                </LinearLayout>

                <!-- BOX 2: Certificato e Musica -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/grigio_box"
                    android:padding="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Certificato e Musica"
                        android:textColor="@color/testo_titoli"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvScadenzaCertificato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nessuna scadenza inserita"
                        android:textColor="@color/testo_sottotitoli"/>
                    <Button
                        android:id="@+id/btnAggiornaCertificato"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aggiorna Certificato"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:id="@+id/tvStatoMusica"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nessuna traccia caricata"
                        android:textColor="@color/testo_sottotitoli"/>
                    <Button
                        android:id="@+id/btnCaricaMusica"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carica Link Dropbox"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnRiproduciMusica"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="▶ Riproduci"
                            android:backgroundTint="@color/viola_torre"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="4dp"/>
                        <Button
                            android:id="@+id/btnFermaMusica"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⏹ Ferma"
                            android:backgroundTint="@color/rosso_alert"
                            android:textColor="@android:color/white"
                            android:visibility="gone"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- BOX 3: Diario Presenze -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/grigio_box"
                    android:padding="24dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diario Presenze"
                        android:textColor="@color/testo_titoli"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChartPresenze"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnAggiungiPresenza"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1 Presenza"
                            android:textColor="@color/verde_acqua_bottoni"/>

                        <Button
                            android:id="@+id/btnAggiungiAssenza"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+1 Assenza"
                            android:textColor="@color/rosso_alert"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnEliminaAtleta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:text="Elimina Ginnasta"
                    android:backgroundTint="@color/rosso_alert"
                    android:textColor="@android:color/white"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>