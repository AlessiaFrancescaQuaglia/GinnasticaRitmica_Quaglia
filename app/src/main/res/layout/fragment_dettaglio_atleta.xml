<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgProfiloAtleta"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/circle_background"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnModificaFoto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 Cambia Foto"
                    android:textColor="#BB86FC"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNomeDettaglio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome Ginnasta"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#6200EA"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/tvCategoriaDettaglio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Livello • Categoria"
                android:textSize="18sp"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginBottom="24dp"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profilo Tecnico"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvLivelloScelto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Livello: Non inserito"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvDataNascita"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data di nascita: Non inserita"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvAttrezziUsati"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attrezzi dell'anno: Nessuno"
                        android:layout_marginTop="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnModificaLivello"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Livello"
                            android:textColor="#BB86FC"/>

                        <Button
                            android:id="@+id/btnModificaNascita"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Età"
                            android:textColor="#BB86FC"/>

                        <Button
                            android:id="@+id/btnModificaAttrezzi"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Attrezzi"
                            android:textColor="#BB86FC"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Certificato Medico"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvScadenzaCertificato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nessuna scadenza inserita"
                        android:layout_marginTop="8dp"/>

                    <Button
                        android:id="@+id/btnAggiornaCertificato"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aggiorna Data"
                        android:textColor="#BB86FC"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="Base Musicale"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/tvStatoMusica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nessuna traccia caricata"
                        android:layout_marginTop="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnCaricaMusica"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carica"
                            android:textColor="#BB86FC"/>

                        <Button
                            android:id="@+id/btnRiproduciMusica"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶ Riproduci"
                            android:textColor="#03DAC5"/>

                        <Button
                            android:id="@+id/btnFermaMusica"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="■ Stop"
                            android:textColor="#CF6679"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnEliminaAtleta"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Elimina Ginnasta"
                android:textColor="#CF6679"
                app:strokeColor="#CF6679"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>
</layout>