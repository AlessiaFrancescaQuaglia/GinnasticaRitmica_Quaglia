<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/sfondo_app">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/viola_torre"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnTornaIndietro"
                android:contentDescription="Torna indietro"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Mio Profilo"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome"
                    android:textColor="@color/viola_torre"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etNomeAllenatrice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints=""
                    android:background="@android:drawable/editbox_background"
                    android:hint="Inserisci il tuo nome"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColorHint="#757575" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cognome"
                    android:textColor="@color/viola_torre"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etCognomeAllenatrice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:autofillHints=""
                    android:background="@android:drawable/editbox_background"
                    android:hint="Inserisci il tuo cognome"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="12dp"
                    android:textColorHint="#757575" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:text="Data di Nascita"
                    android:textColor="@color/viola_torre"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <EditText
                    android:id="@+id/etDataNascitaAllenatrice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="GG/MM/AAAA"
                    android:importantForAutofill="no"
                    android:inputType="date"
                    android:paddingHorizontal="12dp"
                    android:textColorHint="#757575" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tessera Federale (PDF)"
                    android:textColor="@color/viola_torre"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btnCaricaTessera"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/viola_torre"
                        app:strokeColor="@color/viola_torre"
                        android:text="Carica PDF" />

                    <Button
                        android:id="@+id/btnVisualizzaTessera"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Visualizza"
                        android:backgroundTint="@color/verde_acqua_bottoni"
                        android:textColor="@color/testo_titoli"
                        android:visibility="gone"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:id="@+id/btnCambiaTessera"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cambia"
                        android:textColor="@color/viola_torre"
                        app:strokeColor="@color/viola_torre"
                        android:visibility="gone"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatoFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Nessun file selezionato"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSalvaProfilo"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="SALVA PROFILO"
                    android:backgroundTint="@color/viola_torre"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>