<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/sfondo_app">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imgLogoHome"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/icona"
                android:contentDescription="Logo della società Ritmica La Torre"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AlgoRitmica"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/viola_torre"
                android:layout_marginTop="16dp"
                android:textAlignment="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Passione, Eleganza e Movimento"
                android:textColor="#757575"
                android:textSize="16sp"
                android:textStyle="italic" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/grigio_box"
                android:padding="24dp"
                android:layout_marginBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I Nostri Corsi"
                    android:textColor="@color/testo_titoli"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Benvenuti nella nostra piattaforma ufficiale. La nostra associazione offre corsi di Ginnastica Ritmica per tutte le età, partendo dai corsi base (piccoli e grandi) fino ai settori agonistici e promozionali.\n\nAccedi qui sotto ai servizi digitali della società."
                    android:textColor="@color/testo_sottotitoli"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnAccedi"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Accedi come atleta o allenatrice"
                android:backgroundTint="@color/viola_torre"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>
</layout>