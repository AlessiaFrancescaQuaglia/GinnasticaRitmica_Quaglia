<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvNomeGaraItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome Gara"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/tvDataLuogoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 Data - 📍 Luogo"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/tvInfoFiltriItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Livelli: ... \nCategorie: ..."
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:textColor="#888888"/>

        <Button
            android:id="@+id/btnGestisciIscrizioni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gestisci Iscrizioni"
            android:backgroundTint="#03DAC5"
            android:textColor="#000000"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>