<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/sfondo_app"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuova Gara"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/testo_titoli"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etNomeGara"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:autofillHints=""
        android:hint="Nome della Gara (es. Regionale LA)"
        android:textColor="@color/testo_titoli"
        android:textColorHint="@color/testo_chiaro"
        android:background="@android:drawable/editbox_background"
        tools:ignore="TextFields" />

    <EditText
        android:id="@+id/etLuogoGara"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:autofillHints=""
        android:hint="Luogo (es. Palazzetto dello Sport)"
        android:layout_marginTop="8dp"
        android:textColor="@color/testo_titoli"
        android:textColorHint="@color/testo_chiaro"
        android:background="@android:drawable/editbox_background"
        tools:ignore="TextFields" />

    <TextView
        android:id="@+id/tvDataGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleziona Data"
        android:padding="16dp"
        android:textSize="16sp"
        android:textColor="@color/viola_torre"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvLivelliGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleziona Livelli Ammessi"
        android:padding="16dp"
        android:textSize="16sp"
        android:textColor="@color/viola_torre"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvCategorieGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleziona Categorie"
        android:padding="16dp"
        android:textSize="16sp"
        android:textColor="@color/viola_torre"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvAttrezziGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleziona Attrezzi"
        android:padding="16dp"
        android:textSize="16sp"
        android:textColor="@color/viola_torre"
        android:textStyle="bold"/>

</LinearLayout>