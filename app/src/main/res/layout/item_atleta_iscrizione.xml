<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNomeAtletaIscrizione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome Atleta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDettagliAtletaIscrizione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvNomeAtletaIscrizione"
            android:text="Livello - Categoria"
            android:textSize="14sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvStatoIscrizione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvDettagliAtletaIscrizione"
            android:layout_marginTop="8dp"
            android:text="Stato"
            android:textSize="14sp"
            android:textStyle="italic"/>

        <Button
            android:id="@+id/btnGestisciAttrezzi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="Iscrivi"
            android:backgroundTint="#6200EA"
            android:textColor="#FFFFFF" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>