<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/grigio_box"
    android:layout_marginBottom="8dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <TextView
        android:id="@+id/tvNomeAttrezzo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Attrezzo"
        android:textStyle="bold"
        android:textColor="@color/testo_titoli"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btnAscolta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ascolta"
        android:textColor="@color/grigio_box"
        android:backgroundTint="@color/viola_torre"/>
</LinearLayout>