<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="?android:attr/colorBackground"
        tools:context=".LoginFragment">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RhythmicCore"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#BB86FC"
            android:layout_marginBottom="48dp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Email "
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnAccediCoach"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Entra come allenatrice"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />



        <Button
            android:id="@+id/btnAccediAtleta"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Entra come atleta"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accedi con Google"
            android:backgroundTint="#DB4437" />

        <Button
            android:id="@+id/btnRegistrati"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Nuova Allenatrice? Registrati qui"
            android:layout_marginBottom="16dp" />



    </LinearLayout>
</layout>