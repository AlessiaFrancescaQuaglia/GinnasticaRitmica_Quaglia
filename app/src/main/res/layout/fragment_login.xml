<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/sfondo_app"
        tools:context=".ui.fragment.LoginFragment">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AlgoRitmica"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/viola_torre"
            android:layout_marginBottom="48dp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints=""
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:autofillHints=""
            android:hint="Password"
            android:inputType="textPassword"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnAccediCoach"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Entra come allenatrice"
            android:textSize="18sp"
            android:backgroundTint="@color/viola_torre"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnAccediAtleta"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Entra come atleta"
            android:textSize="18sp"
            android:backgroundTint="@color/viola_torre"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />


        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#DB4437"
            android:text="Accedi con Google"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />


        <Button
            android:id="@+id/btnRegistrati"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Nuova Allenatrice? Registrati qui"
            android:textColor="@color/viola_torre"
            app:strokeColor="@color/viola_torre"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRegistratiAtleta"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:text="Sei un'Atleta? Registrati qui"
            android:textColor="#00838F"
            app:strokeColor="@color/verde_acqua_bottoni" />

    </LinearLayout>
</layout>