<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:background="@color/grigio_box"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText, TextContrastCheck, VisualLintButtonSize, VisualLintTextFieldSize">

    <TextView
        android:id="@+id/tvNomeAtletaAppello"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Nome Atleta"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/testo_titoli"/>

    <RadioGroup
        android:id="@+id/radioGroupPresenza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbPresente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/verde_acqua_bottoni"
            android:text="Presente"
            android:textColor="#00796B" />

        <RadioButton
            android:id="@+id/rbAssente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:buttonTint="@color/rosso_alert"
            android:text="Assente"
            android:textColor="#D81B60" />
    </RadioGroup>

</LinearLayout>