<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GinnasticaRitmica" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->

        <!-- Diciamo all'app di usare il tuo stile personalizzato per tutti i popup -->
        <item name="popupMenuStyle">@style/StileNuvoletta</item>
    </style>

    <!-- Lo stile materiale della nuvoletta arrotondata -->
    <style name="StileNuvoletta" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_rounded</item>
        <item name="overlapAnchor">false</item>
    </style>

    <!-- Tema Sicuro per la nuvoletta: eredita dall'app ma forza i testi scuri -->
    <style name="TemaNuvoletta" parent="Base.Theme.GinnasticaRitmica">
        <!-- Colore del testo -->
        <item name="android:textColor">#212121</item>
        <!-- Colore delle icone (Material3) -->
        <item name="colorOnSurface">#212121</item>
    </style>

    <style name="Theme.GinnasticaRitmica" parent="Base.Theme.GinnasticaRitmica" />
    <style name="StileMenuScuro" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:textColor">#1C1C1C</item>
        <item name="iconTint">#1C1C1C</item>
    </style>
</resources>